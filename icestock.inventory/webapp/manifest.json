{
  "_version": "1.60.0",
  "sap.app": {
    "id": "icestock.inventory.icestock.inventory",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "8ae3112d-65e5-42b4-974c-82c40cd1bf22"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.53",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.table": {},
        "sap.ui.layout": {},
        "sap.viz": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "icestock.inventory.icestock.inventory.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "icestock.inventory.icestock.inventory.view",
        "async": true,
        "viewPath": "icestock.inventory.icestock.inventory.view"
      },
      "routes": [
        {
          "name": "RouteMainView",
          "pattern": ":?query:",
          "target": [
            "TargetMainView"
          ]
        },
        {
          "name": "dashboard",
          "pattern": "",
          "target": "dashboard"
        },
        {
          "name": "product",
          "pattern": "product:?query:",
          "target": "product"
        },
        {
          "name": "productDetail",
          "pattern": "product/{productId}",
          "target": "productDetail"
        },
        {
          "name": "stockMovement",
          "pattern": "stockMovement",
          "target": "stockMovement"
        },
        {
          "name": "kpi",
          "pattern": "kpi",
          "target": "kpi"
        },
        {
          "name": "monthlyChart",
          "pattern": "monthlyChart",
          "target": "monthlyChart"
        },
        {
          "name": "categoryChart",
          "pattern": "categoryChart",
          "target": "categoryChart"
        },
        {
          "name": "lowStockTable",
          "pattern": "lowStockTable",
          "target": "lowStockTable"
        },
        {
          "name": "top5Table",
          "pattern": "top5Table",
          "target": "top5Table"
        }

      ],
      "targets": {
        "TargetMainView": {
          "id": "MainView",
          "name": "MainView"
        },
        "product": {
          "id": "product",
          "name": "Product"
        },
        "productDetail": {
          "id": "productDetail",
          "name": "ProductDetail"
        },
        "stockMovement": {
          "id": "stockMovement",
          "name": "stockMovement"
        },
        "dashboard": {
          "viewType": "XML",
          "viewName": "MainView",
          "viewId": "MainView"
        },
        "kpi": {
          "viewType": "XML",
          "viewName": "dashboard.Kpi",
          "viewId": "kpi"
        },
        "monthlyChart": {
          "viewType": "XML",
          "viewName": "dashboard.MonthlyChart",
          "viewId": "monthlyChart"
        },
        "categoryChart": {
          "viewType": "XML",
          "viewName": "dashboard.CategoryChart",
          "viewId": "categoryChart"
        },
        "lowStockTable": {
          "viewType": "XML",
          "viewName": "dashboard.LowStockTable",
          "viewId": "lowStockTable"
        },
        "top5Table": {
          "viewType": "XML",
          "viewName": "dashboard.Top5Table",
          "viewId": "top5Table"
        }
      }
    },
    "rootView": {
      "viewName": "icestock.inventory.icestock.inventory.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
