<mvc:View controllerName="icestock.inventory.icestock.inventory.controller.App"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt">

    <!-- <App id="app"/> -->

    <tnt:ToolPage id="toolPage">
        <!-- 좌측 네비게이션 영역 -->
        <tnt:sideContent>
             <!-- 클릭 시 컨트롤러의 onItemSelect 함수 실행 -->
            <tnt:SideNavigation itemSelect=".onItemSelect">
                <tnt:NavigationList >
                    <!-- key값을 manifest.json의 route name과 동일하게 맞춰 라우팅 관리 -->
                    <tnt:NavigationListItem text="Dashboard" key="dashboard"/>
                    <tnt:NavigationListItem text="Kpi" key="kpi"/>
                    <tnt:NavigationListItem text="Monthly Chart" key="monthlyChart"/>
                    <tnt:NavigationListItem text="Category Chart" key="categoryChart"/>
                    <tnt:NavigationListItem text="Low Stock Table" key="lowStockTable"/>
                    <tnt:NavigationListItem text="Top 5 Table" key="top5Table"/>

                    <tnt:NavigationListItem text="Product" key="product"/>
                    <tnt:NavigationListItem text="Stock Movement" key="stockMovement"/>
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>


        <!-- 우측 메인 컨텐츠 영역 -->
        <tnt:mainContents>
            <!-- 라우터가 Dashboard, Product, StockMovement 등의 뷰를 이곳에 렌더링 함 -->
            <App id="app"/>
        </tnt:mainContents>
    </tnt:ToolPage>

</mvc:View>
