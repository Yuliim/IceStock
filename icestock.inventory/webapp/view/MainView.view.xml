<mvc:View controllerName="icestock.inventory.icestock.inventory.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}" showHeader="false">
        <content>
            <VBox width="100%" class="sapUiSmallMargin">
                <HBox width="100%" class="sapUiSmallMarginBottom">
                    <Panel width="100%">
                        <mvc:XMLView
                            width="100%"
                            viewName="icestock.inventory.icestock.inventory.view.dashboard.Kpi"/>
                    </Panel>
                </HBox>
                <HBox width="100%" alignItems="Stretch" class="sapUiSmallMarginBottom">
                    <Panel width="auto" height="100%" class="sapUiSmallMarginBeginEnd">
                        <layoutData>
                            <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0"/>
                        </layoutData>
                        <mvc:XMLView
                            width="100%"
                            height="100%"
                            viewName="icestock.inventory.icestock.inventory.view.dashboard.MonthlyChart"/>
                    </Panel>
                    <Panel width="auto" height="100%" class="sapUiSmallMarginBeginEnd">
                        <layoutData>
                            <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0"/>
                        </layoutData>
                        <mvc:XMLView
                            width="100%"
                            height="100%"
                            viewName="icestock.inventory.icestock.inventory.view.dashboard.CategoryChart"/>
                    </Panel>
                </HBox>
                <HBox width="100%" alignItems="Stretch">
                    <Panel width="auto" height="100%" class="sapUiSmallMarginBeginEnd">
                        <layoutData>
                            <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0"/>
                        </layoutData>
                        <mvc:XMLView
                            width="100%"
                            height="100%"
                            viewName="icestock.inventory.icestock.inventory.view.dashboard.LowStockTable"/>
                    </Panel>
                    <Panel width="auto" height="100%" class="sapUiSmallMarginBeginEnd">
                        <layoutData>
                            <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0"/>
                        </layoutData>
                        <mvc:XMLView
                            width="100%"
                            height="100%"
                            viewName="icestock.inventory.icestock.inventory.view.dashboard.Top5Table"/>
                    </Panel>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>