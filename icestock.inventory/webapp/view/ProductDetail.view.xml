<mvc:View controllerName="icestock.inventory.icestock.inventory.controller.ProductDetail"
    xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:table="sap.ui.table">
    <!--
        manifest의 productDetail 라우트로 열리는 View다.
        Controller가 상품을 조회·집계하여 detail 모델에 넣으면 이 화면이 표시한다.
        detail>/product/...는 원본 상품 값, detail>/revenue 등은 계산한 요약 값이다.
    -->
    <Page title="상품 상세" showNavButton="true" navButtonPress=".onBack">
        <content>
            <VBox class="sapUiSmallMargin">
                <!-- found가 false이면 안내만 표시한다. {= ... }는 표현식 바인딩이다. -->
                <MessageStrip text="{detail>/message}" visible="{= !${detail>/found} }" showIcon="true" />
                <VBox visible="{detail>/found}">
                    <!-- 1. 기본정보. 금액 문구는 Controller의 formatWon으로 변환한다. -->
                    <ObjectHeader title="{detail>/product/productName}" intro="{detail>/product/productId}" responsive="true">
                        <attributes>
                            <ObjectAttribute title="카테고리" text="{detail>/categoryName}" />
                            <ObjectAttribute title="판매 단위" text="{detail>/product/unit}" />
                            <ObjectAttribute title="매입단가" text="{path:'detail>/product/purchasePrice', formatter:'.formatWon'}" />
                            <ObjectAttribute title="매출단가" text="{path:'detail>/product/sellingPrice', formatter:'.formatWon'}" />
                        </attributes>
                        <statuses><ObjectStatus text="{= ${detail>/product/active} ? '판매 중' : '판매 중지' }"
                            state="{= ${detail>/product/active} ? 'Success' : 'None' }" /></statuses>
                    </ObjectHeader>
                    <!-- 2. 현재 재고와 보충 기준. FlexBox는 폭에 따라 요약 항목을 줄바꿈한다. -->
                    <Panel headerText="재고 현황" class="sapUiSmallMarginTop">
                        <content>
                            <ObjectStatus text="{detail>/stockStatus}" state="{detail>/stockState}" />
                            <FlexBox wrap="Wrap">
                                <VBox width="12rem" class="sapUiSmallMargin"><Label text="현재 재고" /><ObjectNumber number="{detail>/product/stock}" unit="개" state="{detail>/stockState}" /><Text text="안전재고 충족률 {detail>/stockRate}" /></VBox>
                                <VBox width="12rem" class="sapUiSmallMargin"><Label text="안전재고" /><ObjectNumber number="{detail>/product/safetyStock}" unit="개" /></VBox>
                                <VBox width="12rem" class="sapUiSmallMargin"><Label text="재고 금액" /><ObjectNumber number="{path:'detail>/stockValue', type:'sap.ui.model.type.Float', formatOptions:{maxFractionDigits:2}}" unit="원" /><Text text="현재 재고 × 매입단가" /></VBox>
                                <VBox width="12rem" class="sapUiSmallMargin"><Label text="보충 필요수량" /><ObjectNumber number="{detail>/requiredQuantity}" unit="개" /></VBox>
                            </FlexBox>
                        </content>
                    </Panel>
                    <!-- 3. 선택 상품의 전체 판매 내역을 합산한 값이다. 당월 한정 값이 아니다. -->
                    <Panel headerText="판매 현황" class="sapUiSmallMarginTop">
                        <content>
                            <Text text="상품의 전체 판매 이력을 기준으로 계산합니다." />
                            <FlexBox wrap="Wrap">
                                <VBox width="12rem" class="sapUiSmallMargin"><Label text="누적 판매수량" /><ObjectNumber number="{detail>/soldQuantity}" unit="개" /></VBox>
                                <VBox width="12rem" class="sapUiSmallMargin"><Label text="누적 매출액" /><ObjectNumber number="{path:'detail>/revenue', type:'sap.ui.model.type.Float', formatOptions:{maxFractionDigits:2}}" unit="원" /></VBox>
                                <VBox width="12rem" class="sapUiSmallMargin"><Label text="누적 매출원가" /><ObjectNumber number="{path:'detail>/cost', type:'sap.ui.model.type.Float', formatOptions:{maxFractionDigits:2}}" unit="원" /></VBox>
                                <VBox width="12rem" class="sapUiSmallMargin"><Label text="매출총이익" /><ObjectNumber number="{path:'detail>/profit', type:'sap.ui.model.type.Float', formatOptions:{maxFractionDigits:2}}" unit="원" /></VBox>
                                <VBox width="12rem" class="sapUiSmallMargin"><Label text="마진율" /><ObjectNumber number="{detail>/margin}" /><Text text="매출총이익 ÷ 매출액" /></VBox>
                            </FlexBox>
                        </content>
                    </Panel>
                    <!--
                        4. Controller에서 이 상품만 고른 뒤 최신순으로 정렬한 이력.
                        detail>date처럼 /가 없는 경로는 현재 이력 행을 기준으로 읽는다.
                        noData는 이력이 없을 때 표시하며 추가 이력은 스크롤로 볼 수 있다.
                    -->
                    <table:Table rows="{detail>/history}" selectionMode="None" visibleRowCount="8" width="100%"
                        enableColumnReordering="false" noData="입출고 이력이 없습니다." class="sapUiSmallMarginTop">
                        <table:extension><Toolbar><Title text="입출고 이력" level="H2" /></Toolbar></table:extension>
                        <table:columns>
                            <table:Column width="8rem"><Label text="처리일자" /><table:template><Text text="{detail>date}" /></table:template></table:Column>
                            <table:Column width="7rem"><Label text="처리번호" /><table:template><Text text="{detail>movementId}" /></table:template></table:Column>
                            <table:Column width="6rem"><Label text="처리 유형" /><table:template><ObjectStatus text="{detail>typeLabel}" state="{detail>typeState}" /></table:template></table:Column>
                            <table:Column width="7rem"><Label text="처리 사유" /><table:template><Text text="{detail>reasonLabel}" /></table:template></table:Column>
                            <table:Column width="8rem" hAlign="End"><Label text="처리 전 재고" /><table:template><Text text="{detail>beforeStock}개" /></table:template></table:Column>
                            <table:Column width="7rem" hAlign="End"><Label text="처리 수량" /><table:template><ObjectNumber number="{detail>signedQuantity}" unit="개" state="{detail>typeState}" /></table:template></table:Column>
                            <table:Column width="8rem" hAlign="End"><Label text="처리 후 재고" /><table:template><Text text="{detail>afterStock}개" /></table:template></table:Column>
                            <table:Column width="14rem"><Label text="비고" /><table:template><Text text="{detail>note}" /></table:template></table:Column>
                        </table:columns>
                    </table:Table>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
