<mvc:View controllerName="icestock.inventory.icestock.inventory.controller.StockMovement"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns:l="sap.ui.layout">
    <Page title="입출고 이력">
        <content>
            <VBox class="sapUiSmallMargin stockMovementPage">
                <Panel class="sapUiSmallMarginBottom stockMovementRegisterSection">
                    <content>
                        <Toolbar class="stockMovementRegisterToolbar">
                            <Title text="입출고 등록" level="H2" />
                        </Toolbar>
                        <VBox class="sapUiSmallMargin">
                            <Text
                                class="sapUiTinyMarginTop sapUiSmallMarginBottom"
                                text="처리 결과는 현재 재고와 판매 데이터에 즉시 반영됩니다." />
                            <l:Grid
                                defaultSpan="XL12 L12 M12 S12"
                                hSpacing="1.5"
                                vSpacing="1.5"
                                width="100%">
                                <VBox>
                                    <layoutData>
                                        <l:GridData span="XL2 L2 M6 S12" />
                                    </layoutData>
                                    <Label text="처리 일자" />
                                    <DatePicker
                                        id="movementRegisterDate"
                                        width="100%"
                                        displayFormat="yyyy-MM-dd"
                                        valueFormat="yyyy-MM-dd"
                                        placeholder="날짜 선택" />
                                </VBox>
                                <VBox>
                                    <layoutData>
                                        <l:GridData span="XL2 L2 M6 S12" />
                                    </layoutData>
                                    <Label text="처리 유형" />
                                    <SegmentedButton
                                        id="movementRegisterType"
                                        width="100%"
                                        select="onRegisterTypeChange">
                                        <items>
                                            <SegmentedButtonItem key="IN" text="입고" />
                                            <SegmentedButtonItem key="OUT" text="출고" />
                                        </items>
                                    </SegmentedButton>
                                </VBox>
                                <VBox>
                                    <layoutData>
                                        <l:GridData span="XL3 L3 M6 S12" />
                                    </layoutData>
                                    <Label text="상품 선택" />
                                    <ComboBox
                                        id="movementRegisterProduct"
                                        width="100%"
                                        placeholder="상품코드 또는 상품명 검색"
                                        selectionChange="onRegisterProductChange"
                                        change="onRegisterProductChange"
                                        items="{inventory>/products}">
                                        <items>
                                            <core:Item
                                                key="{inventory>productId}"
                                                text="{inventory>productId} · {inventory>productName}" />
                                        </items>
                                    </ComboBox>
                                </VBox>
                                <VBox>
                                    <layoutData>
                                        <l:GridData span="XL2 L2 M6 S12" />
                                    </layoutData>
                                    <Label text="처리 수량" />
                                    <Input
                                        id="movementRegisterQuantity"
                                        width="100%"
                                        type="Number"
                                        placeholder="수량 입력" />
                                </VBox>
                                <VBox>
                                    <layoutData>
                                        <l:GridData span="XL3 L3 M6 S12" />
                                    </layoutData>
                                    <Label text="처리 사유" />
                                    <Select id="movementRegisterReason" width="100%">
                                        <items>
                                            <core:Item key="PURCHASE" text="매입" />
                                            <core:Item key="SALE" text="판매" />
                                            <core:Item key="DISCARD" text="폐기" />
                                        </items>
                                    </Select>
                                </VBox>
                                <VBox>
                                    <layoutData>
                                        <l:GridData span="XL3 L3 M6 S12" />
                                    </layoutData>
                                    <Label text="현재 재고" />
                                    <ObjectStatus
                                        id="movementRegisterCurrentStock"
                                        text="상품을 선택하세요"
                                        state="Information" />
                                </VBox>
                                <VBox>
                                    <layoutData>
                                        <l:GridData span="XL7 L7 M9 S12" />
                                    </layoutData>
                                    <Label text="비고" />
                                    <Input
                                        id="movementRegisterNote"
                                        width="100%"
                                        placeholder="선택 입력" />
                                </VBox>
                                <Button
                                    id="movementRegisterButton"
                                    class="sapUiMediumMarginTop"
                                    text="입고 등록하기"
                                    type="Emphasized"
                                    width="100%"
                                    press="onRegisterMovement">
                                    <layoutData>
                                        <l:GridData span="XL2 L2 M3 S12" />
                                    </layoutData>
                                </Button>
                            </l:Grid>
                        </VBox>
                    </content>
                </Panel>

                <Panel class="sapUiSmallMarginBottom stockMovementFilterSection">
                    <content>
                        <OverflowToolbar class="stockMovementFilterToolbar">
                            <Title text="검색 필터" level="H3" />
                            <ToolbarSeparator />
                            <SearchField
                                id="movementSearchField"
                                width="14rem"
                                placeholder="상품코드 또는 상품명"
                                liveChange="onFilterChange"
                                search="onFilterChange" />
                            <DatePicker
                                id="movementStartDate"
                                width="8rem"
                                displayFormat="yyyy.MM.dd"
                                placeholder="시작일"
                                change="onFilterChange" />
                            <Text text="~" />
                            <DatePicker
                                id="movementEndDate"
                                width="8rem"
                                displayFormat="yyyy.MM.dd"
                                placeholder="종료일"
                                change="onFilterChange" />
                            <Select id="movementTypeSelect" width="8rem" change="onFilterChange">
                                <items>
                                    <core:Item key="ALL" text="전체 유형" />
                                    <core:Item key="IN" text="입고" />
                                    <core:Item key="OUT" text="출고" />
                                </items>
                            </Select>
                            <Select id="movementReasonSelect" width="8rem" change="onFilterChange">
                                <items>
                                    <core:Item key="ALL" text="전체 사유" />
                                    <core:Item key="PURCHASE" text="매입" />
                                    <core:Item key="SALE" text="판매" />
                                    <core:Item key="DISCARD" text="폐기" />
                                </items>
                            </Select>
                            <Select id="movementSortSelect" width="11rem" change="onFilterChange">
                                <items>
                                    <core:Item key="LATEST" text="최신순" />
                                    <core:Item key="OLDEST" text="오래된순" />
                                    <core:Item key="SALES" text="판매량순" />
                                    <core:Item key="QUANTITY_DESC" text="처리수량 많은순" />
                                    <core:Item key="QUANTITY_ASC" text="처리수량 적은순" />
                                </items>
                            </Select>
                            <Button
                                text="초기화"
                                icon="sap-icon://reset"
                                type="Transparent"
                                press="onResetFilters" />
                        </OverflowToolbar>
                    </content>
                </Panel>

                <Panel class="stockMovementResultSection">
                    <content>
                        <Toolbar class="stockMovementToolbar">
                            <Title text="전체 입출고 이력" level="H2" />
                            <Text id="movementCount" text="{= '(' + ${inventory>/movements}.length + '건)' }" />
                        </Toolbar>
                        <t:Table
                            id="stockMovementTable"
                            width="100%"
                            rows="{path: 'inventory>/movements', sorter: {path: 'date', descending: true}}"
                            selectionMode="None"
                            enableColumnReordering="true"
                            fixedColumnCount="2"
                            alternateRowColors="true">
                    <t:columns>
                        <t:Column width="6rem">
                            <t:label><Label text="처리일자" /></t:label>
                            <t:template><Text text="{inventory>date}" /></t:template>
                        </t:Column>
                        <t:Column width="6rem">
                            <t:label><Label text="처리번호" /></t:label>
                            <t:template><Text text="{inventory>movementId}" /></t:template>
                        </t:Column>
                        <t:Column width="11rem">
                            <t:label><Label text="상품명(상품코드)" /></t:label>
                            <t:template><Text text="{parts: [{path: 'inventory>productId'}, {path: 'inventory>/products'}], formatter: '.formatProductLabel'}" /></t:template>
                        </t:Column>
                        <t:Column width="7rem">
                            <t:label><Label text="처리 유형" /></t:label>
                            <t:template>
                                <ObjectStatus
                                    text="{path: 'inventory>type', formatter: '.formatType'}"
                                    state="{path: 'inventory>type', formatter: '.formatTypeState'}" />
                            </t:template>
                        </t:Column>
                        <t:Column width="6rem">
                            <t:label><Label text="처리 사유" /></t:label>
                            <t:template>
                                <VBox>
                                    <Text text="{path: 'inventory>reason', formatter: '.formatReason'}" />
                                </VBox>
                            </t:template>
                        </t:Column>
                        <t:Column width="6rem" hAlign="End">
                            <t:label><Label text="처리 전 재고" /></t:label>
                            <t:template><Text text="{inventory>beforeStock}개" textAlign="End" /></t:template>
                        </t:Column>
                        <t:Column width="6rem" hAlign="End">
                            <t:label><Label text="처리 수량" /></t:label>
                            <t:template><Text text="{parts: [{path: 'inventory>type'}, {path: 'inventory>quantity'}], formatter: '.formatQuantity'}" textAlign="End" /></t:template>
                        </t:Column>
                        <t:Column width="6rem" hAlign="End">
                            <t:label><Label text="처리 후 재고" /></t:label>
                            <t:template><Text text="{inventory>afterStock}개" textAlign="End" /></t:template>
                        </t:Column>
                        <t:Column width="10rem">
                            <t:label><Label text="비고" /></t:label>
                            <t:template><Text text="{inventory>note}" /></t:template>
                        </t:Column>
                    </t:columns>
                        </t:Table>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>