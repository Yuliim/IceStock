<mvc:View controllerName="icestock.inventory.icestock.inventory.controller.dashboard.CategoryChart"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
    <Panel width="100%">
        <VBox>
            <Title text="카테고리별 재고" titleStyle="H3" />
            <Label text="현재 재고 수량 기준" class="sapUiTinyMarginBottom" />
        </VBox>

        <HBox
            alignItems="Center"
            justifyContent="SpaceAround"
            width="100%"
            wrap="Wrap">
            <viz:VizFrame id="idVizFrameE1"
                vizType="donut"
                width="200px"
                height="200px"
                uiConfig="{applicationSet:'fiori'}"
                vizProperties="{ title: {visible: false}, legend: {visible: false},
                general: {layout: {padding: 0, paddingTop: 0, paddingBottom: 0, paddingLeft: 0, paddingRight: 0}},
                plotArea: {colorPalette: ['#6CC4A4', '#94A9E0', '#F4A86A', '#B9A2E0', '#F5D06F', '#F18A92'], dataLabel: {visible: false}} }">
                <viz:layoutData>
                    <FlexItemData growFactor="0" shrinkFactor="0" />
                </viz:layoutData>
                <viz:dataset>
                    <viz.data:FlattenedDataset data="{chart>/categoryStock}">
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="카테고리" value="{chart>categoryName}"/>
                        </viz.data:dimensions>
                        <viz.data:measures>
                            <viz.data:MeasureDefinition name="수량" value="{chart>stock}"/>
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>
                <viz:feeds>
                    <viz.feeds:FeedItem uid="size" type="Measure" values="수량"/>
                    <viz.feeds:FeedItem uid="color" type="Dimension" values="카테고리"/>
                </viz:feeds>
                <viz:dependents>
                    <viz:Popover id="idPopOverE1"/>
                </viz:dependents>
            </viz:VizFrame>

            <!-- 커스텀 범례: 색 점 + 카테고리명 ... 개수(오른쪽 정렬) -->
            <VBox
                items="{chart>/categoryStock}"
                width="9rem"
                class="sapUiSmallMarginBegin">
                <items>
                    <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="sapUiTinyMarginBottom">
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://circle-task-2" size="0.5rem"
                                color="{= ${chart>categoryName}.indexOf('바') === 0 ? '#6CC4A4'
                                    : ${chart>categoryName}.indexOf('콘') === 0 ? '#94A9E0'
                                    : ${chart>categoryName}.indexOf('샌드') === 0 ? '#F4A86A'
                                    : ${chart>categoryName}.indexOf('컵') === 0 ? '#B9A2E0'
                                    : ${chart>categoryName}.indexOf('튜브') === 0 ? '#F5D06F'
                                    : '#F18A92' }" />
                            <FormattedText class="sapUiTinyMarginBegin"
                                htmlText="{= '&lt;span style=&quot;font-size:0.75rem&quot;&gt;' + ${chart>categoryName} + '&lt;/span&gt;' }" />
                        </HBox>
                        <FormattedText
                            htmlText="{= '&lt;strong style=&quot;font-size:0.75rem&quot;&gt;' + ${chart>stock} + '개&lt;/strong&gt;' }" />
                    </HBox>
                </items>
            </VBox>
        </HBox>
    </Panel>
</mvc:View>