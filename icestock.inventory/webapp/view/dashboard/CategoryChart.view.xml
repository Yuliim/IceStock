<mvc:View controllerName="icestock.inventory.icestock.inventory.controller.dashboard.CategoryChart"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
    <Page title="{i18n>title}">
        <Text text="Category Chart"></Text>
        
        <l:Grid containerQuery="true" defaultSpan="XL6 L6 M12 S12" class="sapUiSmallMargin">
            <Panel>
                <layoutData>
                    <l:GridData span="XL4 L4 M12 S12"/>
                </layoutData>
                <VBox>
                    <Title text="카테고리별 재고" level="H3" />
                    <Text text="현재 재고 수량 기준" class="sapUiTinyMarginBottom" />
                </VBox>
                <viz:VizFrame id="idVizFrameE1"
                    vizType="donut"
                    width="100%" height="240px"
                    uiConfig="{applicationSet:'fiori'}"
                    vizProperties="{ title: {visible: false}, legendGroup: {layout: {position: 'right'}}, 
                    legend: {title: {visible: false}, label: {style: {fontSize: '13px'}}} }">
                    <viz:dataset>
                        <viz.data:FlattenedDataset data="{chart>/categoryStock}">
                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition name="카테고리" value="{chart>categoryName}"/>
                            </viz.data:dimensions>
                            <viz.data:measures>
                                <viz.data:MeasureDefinition name="수량" value="{chart>stock}"/>
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>
                    <viz:feeds>
                        <viz.feeds:FeedItem uid="size" type="Measure" values="수량"/>
                        <viz.feeds:FeedItem uid="color" type="Dimension" values="카테고리"/>
                    </viz:feeds>
                    <viz:dependents>
                        <viz:Popover id="idPopOverE1"/>
                    </viz:dependents>
                </viz:VizFrame>
            </Panel>
        </l:Grid>

        

    </Page>
</mvc:View>