<mvc:View controllerName="icestock.inventory.icestock.inventory.controller.dashboard.Kpi"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Panel width="100%">
        <VBox>
            <VBox>
                <Title text="주요 재고 지표" titleStyle="H3"/>
                <Label
                    text="현재 상품 및 재고 현황"
                    class="sapUiTinyMarginBottom"/>
            </VBox>
            
            <HBox width="100%">
            <!--전체 상품 수-->
            <Panel>
                <layoutData>
                    <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0"/>
                </layoutData>
                <VBox class="sapUiSmallMargin">
                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                        <Text text="전체 상품 수"/>
                        <core:Icon src="sap-icon://product" size="1.5rem" color="#107e3e"/>
                    </HBox>
                    <Label text="활성화된 상품 기준"/>  
                    <ObjectNumber number="{kpi>/productCount}" unit="개" class="sapUiSmallMarginTopBottom"/>
                </VBox>
            </Panel>

            <!-- 총 재고 수량-->
            <Panel>
                <layoutData>
                    <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0"/>
                </layoutData>
                <VBox class="sapUiSmallMargin">
                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                        <Text text="총 재고 수량"/>
                        <core:Icon src="sap-icon://inventory" size="1.5rem" color="#0a6ed1"/>
                    </HBox>
                    <Label text="전체 상품 재고 합계"/>
                    <ObjectNumber number="{kpi>/totalStock}" unit="개" class="sapUiSmallMarginTopBottom"/>
                </VBox>
            </Panel>

            <!-- 재고 부족 상품-->
            <Panel>
                <layoutData>
                    <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0"/>
                </layoutData>
                <VBox class="sapUiSmallMargin">
                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                        <Text text="재고 부족 상품"/>
                        <core:Icon src="sap-icon://alert" size="1.5rem" color="#b90000"/>
                    </HBox>
                    <Label text="안전재고 이하 상품"/>
                    <ObjectNumber number="{kpi>/lowStockCount}" unit="개" state="Error" class="sapUiSmallMarginTopBottom"/>
                    
                </VBox>
            </Panel>

            <!-- 이번 달 입출고 -->
            <Panel>
                <layoutData>
                    <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0"/>
                </layoutData>
                <VBox class="sapUiSmallMargin">
                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                        <Text text="이번 달 입출고"/>
                        <core:Icon src="sap-icon://synchronize" size="1.5rem" color="#6a1b9a"/>
                    </HBox>
                    <Label text="입출고 건수 및 당월 입고·출고 수량"/>
                    <ObjectNumber
                        number="{kpi>/monthlyTotal}"
                        unit="건"
                        class="sapUiSmallMarginTopBottom"/>
                    <Text
                        text="{= '입고 ' + ${kpi>/monthlyIn} + '개 · 출고 ' + ${kpi>/monthlyOut} + '개' }"/>
                </VBox>
            </Panel>
            </HBox>
        </VBox>
    </Panel>
</mvc:View>