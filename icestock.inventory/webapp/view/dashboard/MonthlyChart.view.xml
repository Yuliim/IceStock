<mvc:View controllerName="icestock.inventory.icestock.inventory.controller.dashboard.MonthlyChart"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m" 
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:u="sap.ui.unified"
	xmlns:c="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Page title="{i18n>title}">
        <Text text="Monthly Chart"></Text>
        <Panel width="60rem">
       <VBox class="sapUiResponsiveMargin">
        <Title text="월별 입출고 현황" titleStyle="H3" />
        <Label text="최근 6개월간 입고 및 출고 수량" class="sapUiSmallMarginBottom" />
        <layout:Grid ></layout:Grid>
        <viz:VizFrame id="idVizFrame" 
                      vizType="column"
                      width="800px"
                      height="400px"
                      vizProperties='{  "title": { "visible": false },
                                    "valueAxis": {
                                        "title": { "visible": false },
                                        "label": { "formatString": "0" }
                                    },
                                 "categoryAxis": {
                                        "title": { "visible": false },
                                       "label" : {
                                                   "style": {
                                                   "color": "#c6c1c1"}
                                                }
                                        },
                                     "plotArea": {
                                 "colorPalette": ["#80d4b1", "#8b9ee2"] } }'
                                 >
            <viz:dataset>
                <viz.data:FlattenedDataset data="{/MonthlyChart}">
                    <viz.data:dimensions>
                        <viz.data:DimensionDefinition name="월" value="{month}" />
                    </viz.data:dimensions>
                    <viz.data:measures>
                        <viz.data:MeasureDefinition name="입고" value="{inQty}" />
                        <viz.data:MeasureDefinition name="출고" value="{outQty}" />
                    </viz.data:measures>
                </viz.data:FlattenedDataset>
            </viz:dataset>
            <viz:feeds>
                <viz.feeds:FeedItem uid="valueAxis" 
                                    type="Measure" 
                                    values="입고,출고" />
                <viz.feeds:FeedItem uid="categoryAxis" 
                                    type="Dimension" 
                                    values="월" />
            </viz:feeds>
        </viz:VizFrame>
       </VBox>
    </Panel>
    </Page>
</mvc:View>