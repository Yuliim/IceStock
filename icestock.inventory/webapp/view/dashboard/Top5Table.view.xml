<mvc:View controllerName="icestock.inventory.icestock.inventory.controller.dashboard.Top5Table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:u="sap.ui.unified"
	xmlns:c="sap.ui.core">
    <Panel width="100%">
        <HBox justifyContent="SpaceBetween" alignItems="Start">
            <VBox>
                <Title text="누적 인기상품 TOP 5" titleStyle="H3"/>
                <Label
                    text="누적 판매수량 기준"
                    class="sapUiTinyMarginBottom"/>
            </VBox>
            <Button text="전체 보기" type="Transparent" class="top5MoreBtn"
                    icon="sap-icon://arrow-right" iconFirst="false" press=".onTop5"/>
        </HBox>

        <t:Table rows="{top5>/top5Stock}"
                selectionMode="None"
                class="noLineTable">
            <t:columns>
                <t:Column width="3rem" hAlign="Center">
                    <Label text="순위" />
                    <t:template>
                        <Text text="{top5>rank}" class="rankBadge">
                            <customData>
                                <c:CustomData key="rank" value="{= '' + ${top5>rank} }" writeToDom="true"/>
                            </customData>
                        </Text>
                    </t:template>
                </t:Column>
                <t:Column width="6rem" hAlign="Center">
                    <Label text="상품명" />
                    <t:template>
                        <Text text="{top5>productName}"/>
                    </t:template>
                </t:Column>
                <t:Column width="5rem" hAlign="Center">
                    <Label text="카테고리" />
                    <t:template>
                        <Text text="{top5>categoryName}" class="catTag">
                            <customData>
                                <c:CustomData key="cat" value="{top5>categoryName}" writeToDom="true"/>
                            </customData>
                        </Text>
                    </t:template>
                </t:Column>
                <t:Column  hAlign="Center">
                    <Label text="판매수량" />
                    <t:template>
                        <Text text="{top5>quantity}개"/>
                    </t:template>
                </t:Column>
            </t:columns>
        </t:Table>
    </Panel>
</mvc:View>
