<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <!--
        등록과 수정에서 함께 사용하는 Dialog 조각이다. 독립된 Controller는 없다.
        Product Controller가 Fragment.load로 불러오고 이벤트 함수도 제공한다.
        form 모델은 임시 입력값이다. 기본 양방향 바인딩으로 입력이 form에만 반영된다.
        저장 버튼을 눌러 검증을 통과해야 inventory 원본으로 옮겨진다.
    -->
    <Dialog id="productDialog" title="{form>/title}" contentWidth="30rem" draggable="true">
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip text="기존 상품의 코드와 최초 단가는 변경할 수 없습니다. 재고는 입출고에서 관리합니다." showIcon="true" class="sapUiSmallMarginBottom" />
                <!-- isNew=true인 등록 모드에서만 코드와 단가를 입력할 수 있다. -->
                <!-- labelFor는 Label과 입력 컨트롤을 연결한다. 실제 필수값 검증은 onSave가 맡는다. -->
                <Label text="상품코드" required="true" labelFor="productCodeInput" />
                <Input id="productCodeInput" value="{form>/productId}" enabled="{form>/isNew}" />
                <Label text="상품명" required="true" labelFor="productNameInput" class="sapUiTinyMarginTop" />
                <Input id="productNameInput" value="{form>/productName}" placeholder="상품명을 입력하세요" />
                <!-- 표시할 이름과 저장할 categoryId를 분리한다. -->
                <Label text="카테고리" required="true" labelFor="productCategoryInput" class="sapUiTinyMarginTop" />
                <Select id="productCategoryInput" width="100%" selectedKey="{form>/categoryId}" items="{form>/categories}">
                    <core:Item key="{form>categoryId}" text="{form>categoryName}" />
                </Select>
                <!-- Number 입력이어도 빈 값·음수·소수 검증은 Controller에서 별도로 처리한다. -->
                <Label text="안전재고" required="true" labelFor="safetyStockInput" class="sapUiTinyMarginTop" />
                <Input id="safetyStockInput" value="{form>/safetyStock}" type="Number" description="개" />
                <Label text="매입단가" required="true" labelFor="purchasePriceInput" class="sapUiTinyMarginTop" />
                <Input id="purchasePriceInput" value="{form>/purchasePrice}" type="Number" enabled="{form>/isNew}" description="원" />
                <Label text="매출단가" required="true" labelFor="sellingPriceInput" class="sapUiTinyMarginTop" />
                <Input id="sellingPriceInput" value="{form>/sellingPrice}" type="Number" enabled="{form>/isNew}" description="원" />
                <Text text="새 상품은 재고 0개로 등록됩니다. 데이터 변경은 현재 실행 중인 앱에만 반영됩니다." class="sapUiSmallMarginTop" />
            </VBox>
        </content>
        <!-- 저장은 검증 후 원본에 반영한다. 취소는 닫기만 하므로 원본이 유지된다. -->
        <beginButton><Button text="저장하기" type="Emphasized" press=".onSave" /></beginButton>
        <endButton><Button text="취소" press=".onCloseDialog" /></endButton>
    </Dialog>
</core:FragmentDefinition>
